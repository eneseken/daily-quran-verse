# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle/Kotlin daemon caches this project has accumulated locally
/android/.gradle/
/android/.kotlin/

# Signing material — never commit these, Codemagic injects them at build time
*.jks
*.keystore
*.p12
*.mobileprovision
*.cer
key.properties
.env
.env.*

# Debug screenshots dropped in the project root by `flutter screenshot`
flutter_*.png

# App Store listing screenshots — uploaded to App Store Connect by hand,
# not bundled into the app (see pubspec assets), and ~100MB of PNGs.
assets/store/
